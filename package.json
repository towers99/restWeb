  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "rimraf ./dist && tsc && npm run prisma:migrate:prod",
    "start": "npm run build && node dist/app.js",
    "test": "npm run migrate:postgres:test && vitest",
    "test:watch": "npm run migrate:postgres:test && vitest --watch",
    "test:run": "vitest run",
    "test:coverage": "npm run migrate:postgres:test && vitest run --coverage",
    "prisma:migrate:prod": "prisma migrate deploy",
    "migrate:postgres:test": "dotenv -e .env.test -- npx prisma migrate deploy"
  },
