    "dotenv-cli": "^11.1.0",
    "prisma": "^7.10.1",
    "rimraf": "^6.1.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "env-var": "^7.5.0",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
